# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SHOPIFY STOREFRONT CONFIGURATION (Kathryn Lynne)
# Enter your Shopify store domain, e.g. kathryn-lynne.myshopify.com or custom domain
VITE_SHOPIFY_STORE_DOMAIN="kathryn-lynne.myshopify.com"

# Public Storefront Access Token (Generated under Shopify Admin > Apps > Develop Apps > Storefront API)
# Scopes needed: unauthenticated_read_product_listings, unauthenticated_read_product_inventory, unauthenticated_write_checkouts, unauthenticated_read_checkouts
VITE_SHOPIFY_STOREFRONT_TOKEN="your_storefront_access_token_here"

# Storefront API version (defaults to 2024-10 or latest supported)
VITE_SHOPIFY_API_VERSION="2024-10"

# Merchant Contact
VITE_MERCHANT_EMAIL="sandraamartens29@gmail.com"
VITE_WHATSAPP_NUMBER="+2348000000000"
